# =========================================================================
# .env.example
# Plantilla de configuración. Copiar este archivo como ".env" y completar
# los valores reales. El archivo .env NUNCA se sube al repositorio.
#
#   Windows:        copy .env.example .env
#   Linux / macOS:  cp .env.example .env
# =========================================================================

# Clave con la que Flask firma la cookie de sesión.
# Generarla con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ------------------------- MySQL (XAMPP / MySQL 8) -------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=bd_universidad

# --------------------- Base NoSQL: mongo o firebase ------------------------
NOSQL_BACKEND=mongo

# MongoDB Atlas o local. La cadena de Atlas tiene esta forma:
# mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gestion_academica

# Firebase (solo si NOSQL_BACKEND=firebase)
FIREBASE_CREDENTIALS=firebase-key.json

# ------------------------------ Reglas de negocio --------------------------
# Valor sugerido por crédito al registrar una matrícula (en pesos).
VALOR_CREDITO=1000000

# Poner en 1 para ver el detalle de errores de Flask durante el desarrollo.
FLASK_DEBUG=0
